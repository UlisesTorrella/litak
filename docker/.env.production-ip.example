# Replace every 203.0.113.10 occurrence with the server's public IPv4 address.
# Explicit http:// addresses tell Caddy not to request TLS certificates yet.
LITAK_DOMAIN=203.0.113.10
LITAK_WS_DOMAIN=203.0.113.10:9664
LITAK_BASE_URL=http://203.0.113.10
LITAK_ORIGIN=http://203.0.113.10
LITAK_SITE_ADDRESS=http://203.0.113.10
LITAK_WS_ADDRESS=http://203.0.113.10:9664
LITAK_PUBLIC_IP=203.0.113.10
LITAK_ADMIN_EMAIL=admin@example.com
ACME_EMAIL=admin@example.com

# Generate each database password with: openssl rand -hex 32
MONGO_USER=litak
MONGO_PASSWORD=replace_with_64_hex_characters
REDIS_PASSWORD=replace_with_64_hex_characters

# Generate with: openssl rand -hex 64
LITAK_PLAY_SECRET=replace_with_128_hex_characters

# Generate with: openssl rand -base64 16
LITAK_PASSWORD_SECRET=replace_with_base64_secret

# Published runtime images; no compilation should happen on the 20 GB server.
LITAK_IMAGE=ghcr.io/ulisestorrella/litak:latest
LITAK_WS_IMAGE=ghcr.io/ulisestorrella/litak-ws:latest
