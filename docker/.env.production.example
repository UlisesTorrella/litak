# Public DNS names. Create A/AAAA records for both before starting Caddy.
LITAK_DOMAIN=play.example.com
LITAK_WS_DOMAIN=socket.play.example.com
LITAK_BASE_URL=https://play.example.com
LITAK_ORIGIN=https://play.example.com
LITAK_SITE_ADDRESS=play.example.com
LITAK_WS_ADDRESS=socket.play.example.com
LITAK_PUBLIC_IP=203.0.113.10
LITAK_ADMIN_EMAIL=admin@example.com
ACME_EMAIL=admin@example.com

# Use hexadecimal secrets to avoid URI-encoding problems.
# Generate each database password with: openssl rand -hex 32
MONGO_USER=litak
MONGO_PASSWORD=replace_with_64_hex_characters
REDIS_PASSWORD=replace_with_64_hex_characters

# Generate with: openssl rand -hex 64
LITAK_PLAY_SECRET=replace_with_128_hex_characters

# Generate with: openssl rand -base64 16
LITAK_PASSWORD_SECRET=replace_with_base64_secret

# Images published by CI. Keep the default tag immutable for real deployments.
LITAK_IMAGE=ghcr.io/ulisestorrella/litak:latest
LITAK_WS_IMAGE=ghcr.io/ulisestorrella/litak-ws:latest
